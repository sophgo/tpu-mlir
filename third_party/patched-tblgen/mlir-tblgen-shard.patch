+
+void mlir::tblgen::shardOpDefinitions(
+    ArrayRef<Record *> defs,
+    SmallVectorImpl<ArrayRef<Record *>> &shardedDefs) {
+  if (!opShardCount || opShardCount == 1 || defs.size() <= 1) {
+    shardedDefs.push_back(defs);
+    return;
+  }
+  unsigned count = opShardCount;
+  if (count > defs.size())
+    count = defs.size();
+  unsigned shardSize = defs.size() / count;
+  unsigned remainder = defs.size() % count;
+  unsigned offset = 0;
+  for (unsigned i = 0; i < count; ++i) {
+    unsigned size = shardSize + (i < remainder ? 1 : 0);
+    shardedDefs.push_back(defs.slice(offset, size));
+    offset += size;
+  }
+}
